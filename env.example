# Auth0 Configuration for Next.js
# Copy this file to .env.local and fill in your actual Auth0 values

AUTH0_SECRET=your-long-random-secret-key
AUTH0_BASE_URL=https://localhost:3000
NEXT_PUBLIC_AUTH0_BASE_URL=https://localhost:3000
AUTH0_ISSUER_BASE_URL=https://your-domain.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret

# Native mobile Auth0 application client ID (Kotlin PlatformConfig.auth0ClientId)
AUTH0_NATIVE_CLIENT_ID=your-native-client-id
# Optional API audience once created in Auth0 Dashboard → APIs
# AUTH0_AUDIENCE=https://www.lukariagroup.com/api
# NEXT_PUBLIC_AUTH0_AUDIENCE=https://www.lukariagroup.com/api

# Auth0 Management API Configuration (for admin panel)
AUTH0_DOMAIN=your-domain.auth0.com
MANAGEMENT_AUTH0_CLIENT_ID=your-management-client-id
MANAGEMENT_AUTH0_CLIENT_SECRET=your-management-client-secret

# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_DB=lukaria

# Appointment Configuration (Optional - Fallback if MongoDB has no data)
APPOINTMENT_SCHEDULED=false
APPOINTMENT_TIME=14:30
APPOINTMENT_LENGTH=60
APPOINTMENT_DATE=2024-01-15
APPOINTMENT_PROVIDER=Dr. Smith
APPOINTMENT_TYPE=consultation

# USDA Food Data Central API Configuration
# Get your API key from: https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=your-usda-api-key

# Microsoft 365 Configuration for PDF storage and email
MS365_CLIENT_ID=your-microsoft-client-id
MS365_CLIENT_SECRET=your-microsoft-client-secret
MS365_TENANT_ID=your-tenant-id
MS365_EMAIL_FROM=kadriaf@lukariagroup.com
MS365_EMAIL_TO=kadriaf@lukariagroup.com
MS365_SHAREPOINT_SITE_ID=your-sharepoint-site-id
# Optional: Videos folder path in SharePoint (defaults to "Videos" if not set)
MS365_VIDEOS_FOLDER_PATH=Videos

# Optional SEO — comma-separated public profile URLs for JSON-LD sameAs (Facebook, Instagram, LinkedIn, etc.)
# NEXT_PUBLIC_ORG_SAME_AS=https://www.facebook.com/yourpage,https://www.instagram.com/yourprofile
# Optional: override physician Person sameAs (defaults to ORG list if unset)
# NEXT_PUBLIC_PHYSICIAN_SAME_AS=https://www.linkedin.com/in/...

# FitXpress / 3DLOOK body scan (server-only — required on Vercel for /api/body-scan/*)
FITXPRESS_ACCESS_TOKEN=your-fitxpress-access-token
# Optional override (default: https://backend.fitxpress.3dlook.me/api/1.0)
# FITXPRESS_API_BASE=https://backend.fitxpress.3dlook.me/api/1.0
