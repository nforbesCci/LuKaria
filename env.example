# Auth0 Configuration for Next.js
# Copy this file to .env.local and fill in your actual Auth0 values

AUTH0_SECRET=your-long-random-secret-key
AUTH0_BASE_URL=https://localhost:3000
AUTH0_ISSUER_BASE_URL=https://your-domain.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret

# Auth0 Management API Configuration (for admin panel)
AUTH0_DOMAIN=your-domain.auth0.com
MANAGEMENT_AUTH0_CLIENT_ID=your-management-client-id
MANAGEMENT_AUTH0_CLIENT_SECRET=your-management-client-secret

# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_DB=lukaria

# Appointment Configuration (Optional - Fallback if MongoDB has no data)
APPOINTMENT_SCHEDULED=false
APPOINTMENT_TIME=14:30
APPOINTMENT_LENGTH=60
APPOINTMENT_DATE=2024-01-15
APPOINTMENT_PROVIDER=Dr. Smith
APPOINTMENT_TYPE=consultation
