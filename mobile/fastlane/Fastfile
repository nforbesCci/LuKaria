default_platform(:ios)

def distribution_identity_in_keychain?(keychain_path)
  output = sh(
    "security find-identity -v -p codesigning '#{keychain_path}' | grep 'Apple Distribution' || true",
    log: false
  )
  !output.strip.empty?
end

def import_distribution_p12!(keychain_name:, keychain_password:)
  p12_b64 = ENV["IOS_DISTRIBUTION_CERT_P12_BASE64"]
  return if p12_b64.nil? || p12_b64.strip.empty?

  require "base64"
  p12_path = File.join(Dir.tmpdir, "lukaria-distribution.p12")
  File.binwrite(p12_path, Base64.decode64(p12_b64))
  import_certificate(
    certificate_path: p12_path,
    certificate_password: ENV.fetch("IOS_DISTRIBUTION_CERT_PASSWORD"),
    keychain_name: keychain_name,
    keychain_password: keychain_password
  )
  UI.success("Imported Apple Distribution certificate from IOS_DISTRIBUTION_CERT_P12_BASE64")
end

platform :ios do
  desc "Archive, export, and upload Svelte to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH"),
      duration: 1200,
      in_house: false
    )

    team_id = ENV.fetch("APPLE_TEAM_ID")
    bundle_id = "com.lukaria.svelte"
    keychain_name = "lukaria-ci.keychain-db"
    keychain_password = ENV.fetch("CI_KEYCHAIN_PASSWORD", "lukaria-ci-temp")
    keychain_path = File.expand_path("~/Library/Keychains/#{keychain_name}")

    unless File.exist?(keychain_path)
      create_keychain(
        name: keychain_name,
        password: keychain_password,
        default_keychain: true,
        unlock: true,
        timeout: 3600,
        lock_when_sleeps: false
      )
    else
      unlock_keychain(
        path: keychain_path,
        password: keychain_password
      )
    end

    import_distribution_p12!(
      keychain_name: keychain_name,
      keychain_password: keychain_password
    )

    if distribution_identity_in_keychain?(keychain_path)
      UI.success("Using Apple Distribution identity from CI keychain")
    else
      UI.important("No Distribution identity in keychain; creating one via App Store Connect API")
      begin
        cert(
          api_key: api_key,
          development: false,
          force: false,
          keychain_path: keychain_path,
          keychain_password: keychain_password
        )
      rescue => e
        UI.user_error!(
          "Distribution signing failed (#{e.message}). " \
          "Revoke an unused Apple Distribution certificate at developer.apple.com, " \
          "or add repo secrets IOS_DISTRIBUTION_CERT_P12_BASE64 + IOS_DISTRIBUTION_CERT_PASSWORD " \
          "(export a .p12 from Keychain Access), then re-run CI."
        )
      end
    end

    profile_uuid = sigh(
      api_key: api_key,
      app_identifier: bundle_id,
      provisioning_name: "Svelte App Store",
      filename: "Svelte_AppStore.mobileprovision",
      force: true
    )

    output_dir = ENV.fetch("RUNNER_TEMP", "/tmp")

    build_app(
      project: "iosApp/iosApp.xcodeproj",
      scheme: "iosApp",
      configuration: "Release",
      clean: false,
      export_method: "app-store",
      output_directory: output_dir,
      output_name: "Svelte",
      skip_profile_detection: true,
      xcargs: [
        "DEVELOPMENT_TEAM=#{team_id}",
        "CODE_SIGN_STYLE=Manual",
        "CODE_SIGN_IDENTITY='Apple Distribution'",
        "PROVISIONING_PROFILE=#{profile_uuid}"
      ].join(" "),
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: {
          bundle_id => "Svelte App Store"
        },
        uploadSymbols: true,
        manageAppVersionAndBuildNumber: false
      }
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: File.join(output_dir, "Svelte.ipa"),
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
