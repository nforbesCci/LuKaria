# Appointment Configuration Environment Variables
# Copy these to your .env.local file and set the values

# Set to 'true' if appointment is scheduled
APPOINTMENT_SCHEDULED=true

# Appointment time (24-hour format)
APPOINTMENT_TIME=14:30

# Appointment length in minutes
APPOINTMENT_LENGTH=60

# Appointment date (ISO format or YYYY-MM-DD)
APPOINTMENT_DATE=2024-01-15

# Appointment provider name
APPOINTMENT_PROVIDER=Dr. Smith

# Appointment type
APPOINTMENT_TYPE=consultation

# Example configurations:

# For a scheduled appointment:
# APPOINTMENT_SCHEDULED=true
# APPOINTMENT_TIME=10:00
# APPOINTMENT_LENGTH=30
# APPOINTMENT_DATE=2024-01-15
# APPOINTMENT_PROVIDER=Dr. Johnson
# APPOINTMENT_TYPE=follow-up

# For no appointment:
# APPOINTMENT_SCHEDULED=false
